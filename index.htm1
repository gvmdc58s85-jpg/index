<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>My Site</title>
<style>
body{padding:40px;text-align:center;font-family:sans-serif;transition:0.3s}
body.dark{background:#0d1117;color:white}
#theme-toggle{padding:12px 20px;border-radius:8px;border:1px solid #999;cursor:pointer;font-size:16px}
</style>
</head>
<body>

<h1>Welcome 👋</h1>
<button id="theme-toggle" aria-pressed="false">☾ Toggle dark mode</button>

<script>
const themeButton = document.getElementById("theme-toggle");

themeButton.addEventListener("click", function () {
    document.body.classList.toggle("dark");

    const darkModeIsOn = document.body.classList.contains("dark");
    themeButton.setAttribute("aria-pressed", darkModeIsOn);
    themeButton.textContent = darkModeIsOn ? "☀ Switch to light mode" : "☾ Toggle dark mode";
});
</script>

</body>
</html>